{
  "name": "@starlight-protocol/starlight",
  "version": "5.0.0-alpha.1",
  "description": "A minimal, open protocol for routing intent to autonomous Sentinels",
  "main": "src/core/index.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "require": "./src/core/index.js",
      "default": "./src/core/index.js"
    },
    "./core": {
      "types": "./types/core.d.ts",
      "require": "./src/core/index.js",
      "default": "./src/core/index.js"
    },
    "./schema": "./schemas/starlight.core.schema.json"
  },
  "types": "./types/index.d.ts",
  "files": [
    "src/core/",
    "schemas/starlight.core.schema.json",
    "!schemas/README.md",
    "spec/STARLIGHT_CORE_PROTOCOL.md",
    "spec/SECURITY_PROFILE.md",
    "!spec/README.md",
    "types/core.d.ts",
    "types/index.d.ts",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "directories": {
    "test": "test"
  },
  "scripts": {
    "start": "node src/core/start.js",
    "test": "npm run test:core",
    "test:core": "node --test test/unit/core_protocol.test.js test/unit/core_tck.test.js",
    "test:interop": "python -m unittest discover -s test -p test_core_python_sdk.py",
    "test:unit": "npm run test:core",
    "test:legacy": "node --test test/unit/protocol.test.js test/unit/intent_runner.test.js test/unit/protocol_objective.test.js && npm run test:python",
    "test:python": "python -m unittest discover -s test -p test_sdk_actions.py && python -m unittest discover -s test/unit -p test_sentinels_structural.py",
    "test:security": "node --test test/unit/protocol.test.js",
    "test:experiments": "node test/run_all_tests.js",
    "tck": "node tck/src/core_tck.js",
    "lint": "eslint src/core test/unit/core_protocol.test.js examples --ext .js",
    "lint:legacy": "eslint src launcher bin test/unit/*.test.js --ext .js",
    "prepublishOnly": "npm run test"
  },
  "keywords": [
    "starlight",
    "starlight-protocol",
    "intent",
    "agent-protocol",
    "testing",
    "e2e",
    "sentinel",
    "json-rpc",
    "websocket",
    "ai",
    "autonomous-agents"
  ],
  "author": {
    "name": "Dhiraj Das",
    "email": "dhirajdas.666@gmail.com",
    "url": "https://www.dhirajdas.dev"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starlight-protocol/starlight.git"
  },
  "bugs": {
    "url": "https://github.com/starlight-protocol/starlight/issues"
  },
  "homepage": "https://github.com/starlight-protocol/starlight#readme",
  "type": "commonjs",
  "dependencies": {
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "@opentelemetry/api": "^1.7.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.46.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.46.0",
    "@opentelemetry/sdk-metrics": "^1.19.0",
    "@opentelemetry/sdk-trace-base": "^1.19.0",
    "@opentelemetry/sdk-trace-node": "^1.19.0",
    "nanoid": "^5.1.6",
    "playwright": "^1.57.0",
    "eslint": "^8.57.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
