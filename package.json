{
  "name": "@starlight-protocol/starlight",
  "version": "5.0.0-alpha.1",
  "description": "A minimal, open protocol for routing intent to autonomous Sentinels",
  "main": "src/core/index.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "require": "./src/core/index.js",
      "default": "./src/core/index.js"
    },
    "./core": {
      "types": "./types/core.d.ts",
      "require": "./src/core/index.js",
      "default": "./src/core/index.js"
    },
    "./schema": "./schemas/starlight.core.schema.json"
  },
  "types": "./types/index.d.ts",
  "bin": {
    "starlight-core": "bin/starlight-core.js"
  },
  "files": [
    "src/core/",
    "bin/starlight-core.js",
    "schemas/starlight.core.schema.json",
    "!schemas/README.md",
    "spec/STARLIGHT_CORE_PROTOCOL.md",
    "spec/SECURITY_PROFILE.md",
    "!spec/README.md",
    "types/core.d.ts",
    "types/index.d.ts",
    "scripts/proof-e2e.js",
    "examples/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "directories": {
    "test": "test"
  },
  "scripts": {
    "start": "node src/core/start.js",
    "test": "npm run test:core && npm run lint && npm run typecheck && npm run schema:check && npm run tck",
    "test:core": "node --test test/unit/core_protocol.test.js test/unit/core_tck.test.js",
    "test:unit": "npm run test:core",
    "tck": "node tck/src/core_tck.js",
    "proof:e2e": "node scripts/proof-e2e.js",
    "lint": "eslint src/core test/unit/core_protocol.test.js examples scripts bin/starlight-core.js --ext .js",
    "typecheck": "tsc -p tsconfig.contract.json",
    "schema:check": "node scripts/check-contract.js",
    "release:gate": "node scripts/release-gate.js",
    "prepublishOnly": "npm run release:gate"
  },
  "keywords": [
    "starlight",
    "starlight-protocol",
    "intent",
    "agent-protocol",
    "testing",
    "e2e",
    "sentinel",
    "json-rpc",
    "websocket",
    "ai",
    "autonomous-agents"
  ],
  "author": {
    "name": "Dhiraj Das",
    "email": "dhirajdas.666@gmail.com",
    "url": "https://www.dhirajdas.dev"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starlight-protocol/starlight.git"
  },
  "bugs": {
    "url": "https://github.com/starlight-protocol/starlight/issues"
  },
  "homepage": "https://github.com/starlight-protocol/starlight#readme",
  "type": "commonjs",
  "dependencies": {
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "@opentelemetry/api": "^1.7.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.46.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.46.0",
    "@opentelemetry/sdk-metrics": "^1.19.0",
    "@opentelemetry/sdk-trace-base": "^1.19.0",
    "@opentelemetry/sdk-trace-node": "^1.19.0",
    "nanoid": "^5.1.6",
    "playwright": "^1.57.0",
    "eslint": "^8.57.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
