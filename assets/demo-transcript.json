  "scenes": [
    {
      "title": "From a goal to accountable execution",
      "caption": "Starlight / General-purpose agent platform / 5.x alpha",
      "command": "Mission → routing → agent → verification → report",
      "lines": [
        "You define the goal, context, constraints, and steps.",
        "Agents supply tools, models, or deterministic code.",
        "Starlight coordinates execution and records what happened.",
        "This walkthrough uses real Node.js and WebSocket executions."
      ],
      "seconds": 16,
      "narration": "Starlight is a general purpose agent platform. You provide the goal and boundaries. Your agents provide the implementation. Follow real executions through routing, verification, failure, cancellation, and a remote agent."
    },
    {
      "title": "01 / Start with real data",
      "caption": "Three orders. No browser, API key, or model required.",
      "command": "node -p \"JSON.stringify(require('./examples/data-report/orders.json'), null, 2)\"",
      "lines": [
        "[",
        "  {",
        "    \"id\": \"ORDER-1\",",
        "    \"amountCents\": 1200",
        "  },",
        "  {",
        "    \"id\": \"ORDER-2\",",
        "    \"amountCents\": 3500",
        "  },",
        "  {",
        "    \"id\": \"ORDER-3\",",
        "    \"amountCents\": 800",
        "  }",
        "]"
      ],
      "seconds": 15,
      "narration": "We begin with three real orders. Their amounts are twelve hundred, thirty five hundred, and eight hundred cents. The correct total is fifty five hundred cents. This deterministic example needs no model or API key."
    },
    {
      "title": "02 / Discover the agents",
      "caption": "Each agent declares a capability and an execution capacity.",
      "command": "starlight agents --agents examples/data-report/agents.cjs",
      "lines": [
        "order-analyst",
        "  capabilities: structured-data",
        "  capacity: 1",
        "",
        "report-writer",
        "  capabilities: documents",
        "  capacity: 1",
        ""
      ],
      "seconds": 17,
      "narration": "Two agents register different capabilities. The order analyst handles structured data. The report writer creates documents. Each has capacity for one execution. Their claims let the coordinator select the appropriate agent for each step."
    },
    {
      "title": "03 / Express the mission",
      "caption": "Intent describes the outcome. Agent code owns the implementation.",
      "command": "Read examples/data-report/mission.json",
      "lines": [
        "Goal: Produce a verified summary of the order data",
        "",
        "Constraint: maxRows = 1000",
        "",
        "1. Summarize the order data",
        "2. Write the verified order summary"
      ],
      "seconds": 16,
      "narration": "The mission describes an outcome and two ordered steps. First summarize the data, then write the verified summary. A shared maximum row constraint applies to both steps. The platform passes earlier results to the next agent."
    },
    {
      "title": "04 / Execute and verify",
      "caption": "The analyst verifies the total; the writer reads back its file.",
      "command": "starlight demo",
      "lines": [
        "Run: b2bfa425-8d96-4f96-bfa2-d42a49c580b2",
        "Status: completed",
        "",
        "Step 1: completed",
        "  agent: order-analyst",
        "  attempts: 1",
        "  evidence records: 1",
        "Step 2: completed",
        "  agent: report-writer",
        "  attempts: 1",
        "  evidence records: 1",
        "",
        "Verified result: 3 orders / 5500 cents"
      ],
      "seconds": 18,
      "narration": "Now execute the mission. The coordinator selects the analyst, which computes the total and independently verifies it. The writer then creates a real Markdown file and reads it back. Both steps complete, with agent identity, attempts, and evidence recorded."
    },
    {
      "title": "05 / Inspect the saved result",
      "caption": "A saved JSON report retains identity, attempts, values, and evidence.",
      "command": "starlight inspect b2bfa425-8d96-4f96-bfa2-d42a49c580b2",
