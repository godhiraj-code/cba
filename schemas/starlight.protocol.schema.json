{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starlight-protocol.github.io/schemas/starlight.protocol.schema.json",
  "title": "Starlight Protocol inbound message",
  "oneOf": [
    { "$ref": "#/$defs/registration" },
    { "$ref": "#/$defs/pulse" },
    { "$ref": "#/$defs/pong" },
    { "$ref": "#/$defs/contextUpdate" },
    { "$ref": "#/$defs/clear" },
    { "$ref": "#/$defs/wait" },
    { "$ref": "#/$defs/hijack" },
    { "$ref": "#/$defs/resume" },
    { "$ref": "#/$defs/intent" },
    { "$ref": "#/$defs/action" },
    { "$ref": "#/$defs/finish" },
    { "$ref": "#/$defs/startRecording" },
    { "$ref": "#/$defs/stopRecording" },
    { "$ref": "#/$defs/getRecordedSteps" },
    { "$ref": "#/$defs/sideTalk" },
    { "$ref": "#/$defs/warpCapture" },
    { "$ref": "#/$defs/warpRestore" },
    { "$ref": "#/$defs/getPageContext" },
    { "$ref": "#/$defs/sentinelError" }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "envelope": {
      "type": "object",
      "required": ["jsonrpc", "method", "params", "id"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "type": "string" },
        "params": { "type": "object" },
        "id": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "registration": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "properties": {
            "method": { "const": "starlight.registration" },
            "params": {
              "type": "object",
              "required": ["layer", "priority"],
              "properties": {
                "layer": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                },
                "role": { "enum": ["sentinel", "intent", "admin"] },
                "clientType": { "enum": ["sentinel", "intent", "admin"] },
                "priority": { "type": "integer", "minimum": 1, "maximum": 10 },
                "capabilities": {
                  "type": "array",
                  "maxItems": 100,
                  "items": { "type": "string", "maxLength": 100 }
                },
                "selectors": {
                  "type": "array",
                  "maxItems": 100,
                  "items": { "type": "string", "maxLength": 1000 }
                },
                "version": {
                  "type": "string",
                  "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
                },
                "authToken": { "type": ["string", "null"], "maxLength": 4096 }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "pulse": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "properties": {
            "method": { "const": "starlight.pulse" },
            "params": {
              "type": "object",
              "properties": {
                "layer": { "type": "string", "maxLength": 100 },
                "entropy": { "type": ["number", "boolean"] },
                "mutationRate": { "type": "number", "minimum": 0 },
                "networkPending": { "type": "integer", "minimum": 0 },
                "animating": { "type": "boolean" },
                "timestamp": { "type": ["string", "number"] },
                "data": { "type": "object" }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "pong": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "properties": {
            "method": { "const": "starlight.pong" },
            "params": {
              "type": "object",
              "properties": {
                "timestamp": { "type": ["string", "number"] }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "contextUpdate": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "properties": {
            "method": { "const": "starlight.context_update" },
            "params": {
              "type": "object",
              "required": ["context"],
              "properties": {
                "context": { "type": "object" }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "clear": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "properties": {
            "method": { "const": "starlight.clear" },
            "params": {
              "type": "object",
              "properties": {
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "reason": { "type": "string", "maxLength": 500 }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "wait": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "properties": {
            "method": { "const": "starlight.wait" },
            "params": {
              "type": "object",
              "properties": {
                "retryAfterMs": { "type": "integer", "minimum": 0, "maximum": 60000 },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "severity": { "enum": ["soft", "hard"] },
                "reason": { "type": "string", "maxLength": 500 }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "hijack": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "properties": {
            "method": { "const": "starlight.hijack" },
            "params": {
              "type": "object",
              "required": ["reason"],
              "properties": {
                "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
                "obstacle": { "type": "string", "maxLength": 1000 },
                "estimatedDuration": { "type": "integer", "minimum": 0, "maximum": 60000 }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "resume": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "properties": {
            "method": { "const": "starlight.resume" },
            "params": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean" },
                "action_taken": { "type": "string", "maxLength": 500 },
                "re_check": { "type": "boolean" },
                "duration": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "intentParams": {
      "type": "object",
      "properties": {
        "cmd": {
          "enum": [
            "goto", "click", "fill", "select", "hover", "check", "uncheck",
            "scroll", "press", "type", "upload", "screenshot", "checkpoint", "clear"
          ]
        },
        "goal": { "type": "string", "minLength": 1, "maxLength": 500 },
        "selector": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "url": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "text": { "type": "string", "maxLength": 100000 },
        "value": { "type": "string", "maxLength": 10000 },
        "key": { "type": "string", "minLength": 1, "maxLength": 100 },
        "direction": { "enum": ["top", "bottom", "left", "right"] },
        "stabilityHint": { "type": "integer", "minimum": 0, "maximum": 60000 },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "context": { "type": "object" },
        "files": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 4096 },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
            }
          ]
        }
      },
      "additionalProperties": false,
      "anyOf": [
        { "required": ["cmd"] },
        { "required": ["goal"] }
      ],
      "allOf": [
        {
          "if": { "properties": { "cmd": { "const": "goto" } }, "required": ["cmd"] },
          "then": { "required": ["url"] }
        },
        {
          "if": { "properties": { "cmd": { "enum": ["click", "hover", "check", "uncheck"] } }, "required": ["cmd"] },
          "then": { "anyOf": [{ "required": ["selector"] }, { "required": ["goal"] }] }
        },
        {
          "if": { "properties": { "cmd": { "const": "fill" } }, "required": ["cmd"] },
          "then": {
            "required": ["text"],
            "anyOf": [{ "required": ["selector"] }, { "required": ["goal"] }]
          }
        },
        {
          "if": { "properties": { "cmd": { "const": "select" } }, "required": ["cmd"] },
          "then": {
            "required": ["value"],
            "anyOf": [{ "required": ["selector"] }, { "required": ["goal"] }]
          }
        },
        {
          "if": { "properties": { "cmd": { "const": "press" } }, "required": ["cmd"] },
          "then": { "required": ["key"] }
        },
        {
          "if": { "properties": { "cmd": { "const": "type" } }, "required": ["cmd"] },
          "then": { "required": ["text"] }
        },
        {
          "if": { "properties": { "cmd": { "const": "upload" } }, "required": ["cmd"] },
          "then": {
            "required": ["files"],
            "anyOf": [{ "required": ["selector"] }, { "required": ["goal"] }]
          }
        },
        {
          "if": { "properties": { "cmd": { "enum": ["screenshot", "checkpoint"] } }, "required": ["cmd"] },
          "then": { "required": ["name"] }
        }
      ]
    },
    "intent": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "properties": {
            "method": { "const": "starlight.intent" },
            "params": { "$ref": "#/$defs/intentParams" }
          }
        }
      ]
    },
    "actionParams": {
      "type": "object",
      "required": ["cmd"],
      "properties": {
        "cmd": {
          "enum": [
            "click", "fill", "select", "hover", "check", "uncheck", "scroll",
            "press", "type", "upload", "hide", "remove", "get_a11y_snapshot"
          ]
        },
        "selector": { "type": "string", "maxLength": 1000 },
        "text": { "type": "string", "maxLength": 100000 },
        "value": { "type": "string", "maxLength": 10000 },
        "key": { "type": "string", "maxLength": 100 },
        "files": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 4096 },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
            }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "cmd": {
                "enum": ["click", "fill", "select", "hover", "check", "uncheck", "hide", "remove", "upload"]
              }
            }
          },
          "then": { "required": ["selector"] }
        },
        {
          "if": { "properties": { "cmd": { "const": "fill" } } },
          "then": { "required": ["text"] }
        },
        {
          "if": { "properties": { "cmd": { "const": "select" } } },
          "then": { "required": ["value"] }
        },
        {
          "if": { "properties": { "cmd": { "const": "press" } } },
          "then": { "required": ["key"] }
        },
        {
          "if": { "properties": { "cmd": { "const": "type" } } },
          "then": { "required": ["text"] }
        },
        {
          "if": { "properties": { "cmd": { "const": "upload" } } },
          "then": { "required": ["files"] }
        }
      ]
    },
    "action": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "properties": {
            "method": { "const": "starlight.action" },
            "params": { "$ref": "#/$defs/actionParams" }
          }
        }
      ]
    },
    "finish": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "properties": {
            "method": { "const": "starlight.finish" },
            "params": {
              "type": "object",
              "properties": {
                "reason": { "type": "string", "maxLength": 1000 },
                "error": { "type": "string", "maxLength": 10000 },
                "force": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "startRecording": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "properties": {
            "method": { "const": "starlight.startRecording" },
            "params": {
              "type": "object",
              "properties": {
                "url": { "type": "string", "maxLength": 4096 }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "stopRecording": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "properties": {
            "method": { "const": "starlight.stopRecording" },
            "params": {
              "type": "object",
              "properties": {
                "name": { "type": ["string", "null"], "maxLength": 200 }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "getRecordedSteps": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "properties": {
            "method": { "const": "starlight.getRecordedSteps" },
            "params": { "type": "object", "maxProperties": 0 }
          }
        }
      ]
    },
    "sideTalk": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "properties": {
            "method": { "const": "starlight.sidetalk" },
            "params": {
              "type": "object",
              "required": ["to", "topic", "payload"],
              "properties": {
                "from": { "type": "string", "maxLength": 100 },
                "to": { "type": "string", "maxLength": 100 },
                "topic": { "type": "string", "maxLength": 200 },
                "payload": {},
                "replyTo": { "type": "string", "maxLength": 128 }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "warpCapture": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "properties": {
            "method": { "const": "starlight.warp_capture" },
            "params": { "type": "object" }
          }
        }
      ]
    },
    "warpRestore": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "properties": {
            "method": { "const": "starlight.warp_restore" },
            "params": { "type": "object" }
          }
        }
      ]
    },
    "getPageContext": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "properties": {
            "method": { "const": "starlight.getPageContext" },
            "params": { "type": "object", "maxProperties": 0 }
          }
        }
      ]
    },
    "sentinelError": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "properties": {
            "method": { "const": "starlight.error" },
            "params": {
              "type": "object",
              "required": ["error"],
              "properties": {
                "error": { "type": "string", "maxLength": 10000 },
                "stack": { "type": "string", "maxLength": 50000 }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    }
  }
}
