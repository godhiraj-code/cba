{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starlight.dev/schemas/starlight.core.schema.json",
  "title": "Starlight Protocol 5.x Wire Contract 1.0",
  "oneOf": [
    { "$ref": "#/$defs/register" },
    { "$ref": "#/$defs/intentRequest" },
    { "$ref": "#/$defs/offer" },
    { "$ref": "#/$defs/execute" },
    { "$ref": "#/$defs/cancel" },
    { "$ref": "#/$defs/successResponse" },
    { "$ref": "#/$defs/errorResponse" }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "request": {
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "type": "string" },
        "params": { "type": "object" }
      },
      "additionalProperties": false
    },
    "intent": {
      "type": "object",
      "required": ["goal"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "goal": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "context": { "type": "object" },
        "constraints": { "type": "object" }
      },
      "additionalProperties": false
    },
    "routedIntent": {
      "allOf": [
        { "$ref": "#/$defs/intent" },
        { "required": ["id"] }
      ]
    },
    "claim": {
      "type": "object",
      "properties": {
        "accept": { "type": "boolean" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "reason": { "type": "string" },
        "metadata": {}
      },
      "additionalProperties": false
    },
    "claimValue": {
      "oneOf": [
        { "type": "boolean" },
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "$ref": "#/$defs/claim" }
      ]
    },
    "outcome": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": { "const": "completed" },
            "value": {},
            "evidence": {}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["status", "error"],
          "properties": {
            "status": { "const": "failed" },
            "error": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                {
                  "type": "object",
                  "required": ["message"],
                  "properties": {
                    "message": { "type": "string", "minLength": 1 },
                    "code": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "evidence": {}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": { "const": "unhandled" },
            "evidence": {}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": { "const": "retry" },
            "error": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                {
                  "type": "object",
                  "required": ["message"],
                  "properties": {
                    "message": { "type": "string", "minLength": 1 },
                    "code": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "evidence": {},
            "retryAfterMs": { "type": "integer", "minimum": 0, "maximum": 60000 }
          },
          "additionalProperties": false
        }
      ]
    },
    "sentinelDescription": {
      "type": "object",
      "required": ["id", "name", "version", "priority", "capacity", "active", "capabilities"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "maxLength": 50 },
        "priority": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "capacity": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "active": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "capabilities": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "required": ["sentinel", "attempt", "status"],
      "properties": {
        "sentinel": { "$ref": "#/$defs/sentinelDescription" },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 10 },
        "status": { "enum": ["completed", "failed", "unhandled", "retry", "error"] },
        "error": { "type": "string" }
      },
      "additionalProperties": false
    },
    "intentResult": {
      "type": "object",
      "required": ["intentId", "goal", "status", "sentinel", "attempts", "durationMs"],
      "properties": {
        "intentId": { "$ref": "#/$defs/id" },
        "goal": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "status": { "const": "completed" },
        "sentinel": { "$ref": "#/$defs/sentinelDescription" },
        "value": {},
        "evidence": {},
        "attempts": {
          "type": "array",
          "maxItems": 10,
          "items": { "$ref": "#/$defs/attempt" }
        },
        "durationMs": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "register": {
      "allOf": [
        { "$ref": "#/$defs/request" },
        {
          "required": ["id"],
          "properties": {
            "method": { "const": "starlight.register" },
            "params": {
              "type": "object",
              "required": ["role", "name", "protocolVersion"],
              "properties": {
                "role": { "enum": ["client", "sentinel"] },
                "id": { "$ref": "#/$defs/id" },
                "name": { "type": "string", "minLength": 1, "maxLength": 200 },
                "version": { "type": "string", "maxLength": 50 },
                "protocolVersion": { "type": "string", "maxLength": 20 },
                "priority": { "type": "integer", "minimum": 0, "maximum": 1000000 },
                "capacity": { "type": "integer", "minimum": 1, "maximum": 1000 },
                "capabilities": {
                  "type": "array",
                  "maxItems": 100,
                  "items": { "type": "string", "minLength": 1, "maxLength": 100 },
                  "uniqueItems": true
                },
                "token": { "type": "string", "minLength": 16 }
              },
              "allOf": [
                {
                  "if": {
                    "properties": { "role": { "const": "client" } },
                    "required": ["role"]
                  },
                  "then": {
                    "not": {
                      "anyOf": [
                        { "required": ["id"] },
                        { "required": ["version"] },
                        { "required": ["priority"] },
                        { "required": ["capacity"] },
                        { "required": ["capabilities"] }
                      ]
                    }
                  }
                }
              ],
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "intentRequest": {
      "allOf": [
        { "$ref": "#/$defs/request" },
        {
          "required": ["id"],
          "properties": {
            "method": { "const": "starlight.intent" },
            "params": { "$ref": "#/$defs/intent" }
          }
        }
      ]
    },
    "offer": {
      "allOf": [
        { "$ref": "#/$defs/request" },
        {
          "required": ["id"],
          "properties": {
            "method": { "const": "starlight.offer" },
            "params": {
              "type": "object",
              "required": ["intent"],
              "properties": { "intent": { "$ref": "#/$defs/routedIntent" } },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "execute": {
      "allOf": [
        { "$ref": "#/$defs/request" },
        {
          "required": ["id"],
          "properties": {
            "method": { "const": "starlight.execute" },
            "params": {
              "type": "object",
              "required": ["intent", "attempt", "claim", "history"],
              "properties": {
                "intent": { "$ref": "#/$defs/routedIntent" },
                "attempt": { "type": "integer", "minimum": 1, "maximum": 10 },
                "claim": { "$ref": "#/$defs/claim" },
                "history": {
                  "type": "array",
                  "maxItems": 10,
                  "items": { "$ref": "#/$defs/attempt" }
                }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "cancel": {
      "allOf": [
        { "$ref": "#/$defs/request" },
        {
          "properties": {
            "method": { "const": "starlight.cancel" },
            "params": {
              "type": "object",
              "required": ["intentId"],
              "properties": { "intentId": { "$ref": "#/$defs/id" } },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "successResponse": {
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "result": {
          "oneOf": [
            { "$ref": "#/$defs/claimValue" },
            { "$ref": "#/$defs/outcome" },
            { "$ref": "#/$defs/intentResult" },
            {
              "type": "object",
              "required": ["registered", "role", "protocolVersion"],
              "properties": {
                "registered": { "const": true },
                "role": { "enum": ["client", "sentinel"] },
                "protocolVersion": { "const": "1.0" }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["cancelled"],
              "properties": { "cancelled": { "type": "boolean" } },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "errorResponse": {
      "type": "object",
      "required": ["jsonrpc", "id", "error"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": ["string", "null"] },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "integer" },
            "message": { "type": "string" },
            "data": {
              "type": "object",
              "required": ["protocolCode"],
              "properties": {
                "protocolCode": { "type": "string" },
                "details": {}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
